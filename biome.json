{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"maxSize": 10485760,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/tailwind.css",
			"!**/index.css",
			"!**/assets/torn-territory-map.svg",
			"!**/assets/torn-territory-map.ts",
			"!**/public/torn-territory-map.svg",
			"!**/*.svg"
		]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
