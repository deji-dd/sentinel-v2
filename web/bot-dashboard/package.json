{
	"name": "@sentinel/bot-dashboard",
	"module": "src/main.tsx",
	"type": "module",
	"private": true,
	"scripts": {
		"build:css": "bunx tailwindcss -i src/index.css -o src/tailwind.css --minify",
		"build": "bun run build:css && NODE_ENV=production bun build index.html --outdir ./dist --target browser --production",
		"dev": "bunx tailwindcss -i src/index.css -o src/tailwind.css --watch & NODE_ENV=development bun build index.html --outdir ./dist --target browser --watch"
	},
	"dependencies": {
		"@elysiajs/eden": "latest",
		"@sentinel/api": "workspace:*",
		"@sentinel/schemas": "workspace:*",
		"@sentinel/utils": "workspace:*",
		"class-variance-authority": "latest",
		"clsx": "latest",
		"lucide-react": "latest",
		"next-themes": "^0.4.6",
		"radix-ui": "latest",
		"react": "latest",
		"react-dom": "latest",
		"shadcn": "latest",
		"sonner": "latest",
		"tailwind-merge": "latest",
		"tw-animate-css": "latest"
	},
	"devDependencies": {
		"@tailwindcss/cli": "latest",
		"@tailwindcss/postcss": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"postcss": "latest",
		"tailwindcss": "latest"
	}
}
