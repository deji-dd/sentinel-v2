{
	"name": "sentinel-v2",
	"workspaces": [
		"services/*",
		"web/*",
		"packages/*"
	],
	"module": "index.ts",
	"scripts": {
		"db:generate": "bun --filter @sentinel/database db:generate",
		"db:migrate": "bun --filter @sentinel/database db:migrate",
		"merc:backfill": "bun run scripts/merc-backfill-hits.ts",
		"scheduler:start": "NODE_ENV=production bun run services/scheduler/index.ts",
		"scheduler:dev": "NODE_ENV=development bun --watch run services/scheduler/index.ts",
		"bot:start": "NODE_ENV=production bun run services/bot/index.ts",
		"bot:dev": "NODE_ENV=development bun --watch run services/bot/index.ts",
		"api:start": "NODE_ENV=production bun run services/api/index.ts",
		"api:dev": "NODE_ENV=development bun --watch run services/api/index.ts",
		"dashboard:build": "bun --filter @sentinel/dashboard build",
		"dashboard:dev": "bun --filter @sentinel/dashboard dev",
		"bot-dashboard:build": "bun run dashboard:build",
		"bot-dashboard:dev": "bun run dashboard:dev",
		"tt-selector:build": "bun --filter @sentinel/tt-selector build",
		"tt-selector:dev": "bun --filter @sentinel/tt-selector dev",
		"elims-dashboard:build": "bun --filter @sentinel/elims-dashboard build",
		"elims-dashboard:dev": "bun --filter @sentinel/elims-dashboard dev",
		"subversive-dashboard:build": "bun run dashboard:build",
		"subversive-dashboard:dev": "bun run dashboard:dev",
		"web:build": "bun --filter \"@sentinel/dashboard\" --filter \"@sentinel/elims-dashboard\" --filter \"@sentinel/tt-selector\" --parallel build",
		"trigger": "bun run services/scheduler/src/scripts/trigger.ts",
		"refresh:alliances": "bun run scripts/refresh-faction-alliances.ts",
		"torn-types:generate": "bun --bun openapi-typescript https://www.torn.com/swagger/openapi.json -o packages/schemas/src/torn/swagger.ts",
		"scripts:build": "bun run blasted:build && bun run subversive:build",
		"blasted:build": "bun run scripts/personal/build.ts",
		"blasted:bump": "bun run scripts/personal/build.ts --bump",
		"subversive:build": "bun run scripts/subversive/build.ts",
		"subversive:bump": "bun run scripts/subversive/build.ts --bump",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"sync:env": "rsync -avz .env.production root@dejis-cloud:/opt/sentinel-v2/.env.production",
		"pre-push": "bun typecheck && bun lint:fix && bun test"
	},
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/bun": "latest",
		"openapi-typescript": "latest",
		"postgres": "latest",
		"typescript": "latest"
	},
	"peerDependencies": {}
}
